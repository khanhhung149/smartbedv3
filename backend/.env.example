# Copy thành .env (đã gitignore). Điền giá trị thật.
MQTT_HOST=192.168.1.50
MQTT_PORT=1883
MQTT_USER=homeuser
MQTT_PASS=changeme123
MQTT_CLIENT_ID=home-backend
ENTER_WINDOW_S=15
EXIT_TIMEOUT_S=60
HTTP_ADDR=:8080
# Lịch sử event (GET /api/events). Trong compose trỏ vào volume home-data.
# Để rỗng = tắt lịch sử (backend vẫn chạy, /api/events trả 503).
DB_PATH=/data/home.db
# Voice/ASR (service faster-whisper self-host, xem docker-compose.yml service "asr")
ASR_URL=http://asr:9000/transcribe
# Cắt câu thật do node quyết định: nó gửi khung text "eou" ngay khi utterance kết thúc.
# ASR_SILENCE_MS chỉ còn là LƯỚI AN TOÀN cho trường hợp mất khung đó. Để 800 thì mỗi lần TCP tới
# node tắc >800ms (đo 18/08: một lần sendBIN block 1,23s) là câu bị cắt đôi giữa chừng, dù node
# vẫn thu đủ audio. 2500 phủ được các lần tắc đã quan sát mà không đụng ASR_MAX_UTTER_MS.
ASR_SILENCE_MS=2500
ASR_MAX_UTTER_MS=8000
VOICE_SAMPLE_RATE=16000
