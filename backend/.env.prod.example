# Production environment template — copy to .env.prod and fill values.
# Real .env.prod is gitignored. Never commit secrets.

ENV=prod
API_DOMAIN=https://api.example.com
MQTT_DOMAIN=wss://mqtt.example.com

# Postgres (TimescaleDB) — credentials for the dockerized DB
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=sleeptech

# JWT signing key — 64+ random chars (e.g. `openssl rand -hex 32`)
JWT_SECRET=

# Mosquitto MQTT credentials
# Backend (subscriber) creds
MQTT_USERNAME=
MQTT_PASSWORD=
# Shared device creds handed to ESP32 via BLE provisioning
MQTT_DEVICE_USERNAME=
MQTT_DEVICE_PASSWORD=

# Firebase Admin SDK service account JSON (mounted into container)
FCM_CREDENTIALS_HOST_PATH=./secrets/fcm.json

# SMTP — production email provider (e.g. MXroute, AWS SES, Postmark)
# Empty MAIL_SERVER → email_service skips send and logs OTP to stdout (dev mode).
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Your App
MAIL_SERVER=
MAIL_PORT=465
MAIL_SSL_TLS=True
MAIL_STARTTLS=False
USE_CREDENTIALS=True
VALIDATE_CERTS=True
