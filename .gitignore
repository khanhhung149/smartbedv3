# ── Secrets ────────────────────────────────────────────────────────────────
.env*
!.env.example
*.pem
*.key
secrets/

# ── OS / editor ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── firmware/ (ESP32 — PlatformIO / ESP-IDF) ───────────────────────────────
.pio/
.pioenvs/
.piolibdeps/
firmware/**/build/
managed_components/
# sdkconfig.<env> (e.g. sdkconfig.esp32cam) is regenerated from sdkconfig.defaults on
# every build — only the defaults file is source-controlled. Caught missing here by
# code review when esp32cam-node became the repo's first pure-ESP-IDF (non-Arduino)
# node: `git add -n` showed sdkconfig.esp32cam*/sdkconfig.old would be tracked.
firmware/**/sdkconfig.*
!firmware/**/sdkconfig.defaults
# WiFi/credentials — never commit. config.h.example stays tracked (no real values).
firmware/**/config.h
firmware/**/config.h.bak*

# ── edge/ (Python — Jetson Orin) ───────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Models are large binaries — track with Git LFS or an artifact store, not git
*.pt
*.onnx
*.engine
*.tflite
# MediaPipe Tasks bundle — scripts/pose-poc/download_model.sh tải lại khi cần.
*.task

# ── Recorded sleep data — NEVER commit (large + personal biometric data) ────
# Real overnight recordings from Phase 01 onward. Disk is cheap, git is not,
# and this is biometric data about identifiable people.
#
# Anchored with a leading slash on purpose. A bare `data/` matches a directory
# named data at ANY depth, and it silently swallowed app/lib/data/ — the app's
# whole data layer was untracked for as long as that rule stood. Point at the
# directories that actually hold recordings; add new ones explicitly.
/edge/data/
recordings/
*.sqlite
*.sqlite3
*.db
*.csv
!docs/**/*.csv

# ── cloud/ (K8s) ───────────────────────────────────────────────────────────
node_modules/
dist/
build/
*.tsbuildinfo
kubeconfig
*.kubeconfig

# ── app/ (Flutter) ─────────────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
GoogleService-Info.plist
google-services.json

# ── mech/ (CAD) ────────────────────────────────────────────────────────────
# Keep source CAD + exported STEP/STL. Ignore solver/backup churn.
*.f3d.bak
*~$*
mech/**/exports/tmp/

# ── Tooling — not part of the product ──────────────────────────────────────
# ClaudeKit toolchain, installed per-machine. Track only the repo rules that
# Claude Code reads, so the team shares conventions without vendoring ~1400 files.
# (git cannot un-ignore inside an ignored directory, hence /* rather than /)
/.claude/*
!/.claude/rules/
release-manifest.json
.repomixignore
repomix-output.xml
logs.txt
.gemini/
.serena/cache

# ── Local scratch (NAS shortcuts, throwaway files) ─────────────────────────
stuffs/

# ── app/ (Flutter) ─────────────────────────────────────────────────────────
# Artifact của từng client nằm ở khối "rải theo tier" bên dưới — app/ giờ có ba
# thư mục con nên luật neo thẳng vào app/build/ không còn đúng.
app/**/*.iml
# The dev token is a real 30-day credential, passed via --dart-define or the
# in-app settings screen — never a file. This is belt-and-braces for the case
# where someone writes one down anyway.
*.env

# ── Sau khi rải presence-ac và sleep-pad theo tier ─────────────────────────
# Các luật dưới đây trước nằm trong .gitignore riêng của hai repo và neo theo
# đường dẫn cũ. File đã đổi chỗ nên luật phải đổi theo — mỗi dòng đang che một
# secret thật hoặc một artifact sinh lại được, đừng xoá vì tưởng trùng lặp.

# Bí mật của broker và backend
cloud/mqtt/passwd
cloud/sleeppad/mosquitto/passwords
cloud/sleeppad/secrets/
cloud/sleeppad/.env.dev
cloud/sleeppad/.env.prod
cloud/presence-ac/bin/
cloud/presence-ac/data/

# Firmware: config.h chứa SSID/mật khẩu WiFi, chỉ commit bản .example
firmware/**/config.h
firmware/**/config.h.bak*
firmware/**/managed_components/
firmware/**/sdkconfig.*

# Artifact của ba app Flutter
app/*/build/
app/*/.dart_tool/
app/*/.flutter-plugins-deps
app/*/android/.gradle/
app/*/android/local.properties
app/**/test/failures/

# CAD sinh lại được từ nguồn
mech/presence-ac-enclosure/vo-so-*.stl
mech/presence-ac-enclosure/vo-so-*.png
mech/presence-ac-enclosure/vo-hop-LAP-RAP-xem-thoi.stl
