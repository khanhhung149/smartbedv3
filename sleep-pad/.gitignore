# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
dist/
bin/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# package manager
package-lock.json
yarn.lock
# Track pnpm-lock for CI reproducible installs (frozen-lockfile)
!pnpm-lock.yaml

# semantic-release
.nyc_output

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# flutter
.dart_tool
/build
/flutter_app/build/
/flutter_app/.dart_tool/
/flutter_app/ios/Pods/
/flutter_app/ios/.symlinks/
GoogleService-Info.plist

# PlatformIO
/firmware/.pio/

# Python
__pycache__/
*.pyc
*.pyo

# Backend secrets & credentials
backend/secrets/
backend/mosquitto/passwords
backend/.env.dev
backend/.env.prod

repomix-output.xml
.serena/cache
screenshots/*
docs/screenshots/*
logs.txt
test-ck

# CK meta commands
prompt.md
ck.md

# Generated runtime layout for release/install smoke tests
/.claude/

# Local-only state inside tracked claude source
claude/agent-memory/
claude/hooks/.logs/
claude/session-state/latest.md
claude/session-state/archive/
claude/settings.bak.json
claude/skills/ai-multimodal/assets/demo-*.claude/session-state/*.tmp

# Gemini CLI settings (symlink to staged .claude/.mcp.json)
.gemini/settings.json

# External repos for study/reference
external/

# Git worktrees (local development only)
worktrees/

# Generated OpenCode backup from scripts/generate-opencode.py --force
.opencode.backup/

.opencode/
