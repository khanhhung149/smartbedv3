// Copy file này thành config.h rồi điền giá trị thật.
// config.h ĐÃ bị .gitignore — không bao giờ commit credentials.
#pragma once

// SSID để QUÉT KÊNH, KHÔNG phải để kết nối.
// Board này không nối WiFi (chạy ESP-NOW). Nhưng voice-node thì có nối, nên radio của nó
// bị khoá vào kênh của router — ESP-NOW bắt buộc cùng kênh mới tới nơi. Board này quét
// SSID này để dò ra kênh đó.
// -> KHÔNG cần WIFI_PASS: không bao giờ connect.
#define WIFI_SSID       "ten-wifi"

// MAC của voice-node (ESP32 WROOM-32) — đích nhận ESP-NOW.
// LẤY Ở ĐÂU: nạp voice-node trước, xem serial dòng:
//     [espnow] MAC board này: AA:BB:CC:DD:EE:FF
// rồi điền vào đây theo dạng {0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF}.
#define ESPNOW_PEER_MAC { 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 }

// ĐÃ GỠ (không còn dùng):
//   MQTT_*      -> board này không publish nữa; voice-node relay hộ lên broker
//   OTA_*       -> bỏ WiFi nên không OTA được, chỉ nạp USB
//   BACKEND_*   -> không nói chuyện với backend
