// Copy file này thành config.h rồi điền giá trị thật.
// config.h ĐÃ bị .gitignore — không bao giờ commit credentials.
#pragma once

#define WIFI_SSID       "ten-wifi"
#define WIFI_PASS       "mat-khau-wifi"

// MQTT broker (LAN).
#define MQTT_HOST       "192.168.1.95"
#define MQTT_PORT       1883
#define MQTT_USER       "user"
#define MQTT_PASS       "password"
#define MQTT_CLIENT_ID  "radar-node"      // phải duy nhất trên broker

// %topic% khuôn tele/stat — dựng tele/<topic>/SENSOR, stat/<topic>/STATUS10, tele/<topic>/LWT.
// Đây cũng là "topic thiết bị" bạn nhập ở tab "Thiết bị" trong app để nó đọc radar.
#define DEVICE_TOPIC    "radar_phong_khach"

// IP tĩnh — chỉ mở khi mạng không cấp DHCP dùng được (ví dụ Mobile hotspot của Windows:
// board liên kết được sóng nhưng không bao giờ nhận lease). Bỏ trống ba dòng này thì xin DHCP.
// #define WIFI_STATIC_IP   "192.168.137.50"
// #define WIFI_STATIC_GW   "192.168.137.1"
// #define WIFI_STATIC_MASK "255.255.255.0"

// OTA — nạp firmware qua WiFi (POST /update, xem src/ota.c). OTA_HOSTNAME cũng là tên mDNS
// (<hostname>.local) và hostname DHCP của board.
#define OTA_HOSTNAME    "radar-node"
// Gửi kèm header X-OTA-Password khi nạp. Đi trong LAN qua HTTP thường nên đây là rào chống nhầm
// tay, không phải chống nghe lén. Trống = ai cùng LAN cũng nạp được.
#define OTA_PASSWORD    "doi-mat-khau-nay"
