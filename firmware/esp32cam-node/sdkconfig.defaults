# AI-Thinker ESP32-CAM có 4MB PSRAM onboard, nhưng ESP-IDF không tự bật —
# thiếu file này khiến esp32-camera driver malloc frame buffer trong PSRAM thất bại
# ("cam_dma_config: frame buffer malloc failed") dù chip có PSRAM vật lý thật. Bắt
# được lỗi này khi flash lên phần cứng thật lần đầu (13/08).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MODE_QUAD=y

# FatFs mặc định KHÔNG bật Long File Name (chỉ 8.3) — "frame_000000.jpg" (12 ký tự
# tên) dài hơn giới hạn 8 ký tự, fopen() thất bại lặp lại dù thư mục 8 ký tự
# "20260813" vẫn mkdir/mount bình thường. Bắt được lỗi này khi flash lên phần cứng
# thật (13/08) — thư mục đủ ngắn nên không lộ ra tới khi tạo file.
CONFIG_FATFS_LFN_HEAP=y
